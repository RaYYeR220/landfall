# Aurora Intents API key (Intents Studio). Server side only.
AURORA_API_KEY=
# Solana RPC (mainnet)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=/api/solana-rpc
# Keeper key (base58 secret or JSON array) — pays sweeps, inbox rent and allocation fees
KEEPER_SECRET_KEY=
# Demo "fire a live deposit" sender (EVM private key) and caps
DEMO_EVM_PRIVATE_KEY=
DEMO_FIRE_AMOUNT_USDC=1
DEMO_FIRE_DAILY_CAP=40
BASE_RPC_URL=https://mainnet.base.org
DEMO_ENABLED=false
MAX_NEW_INBOXES_PER_HOUR=60
KEEPER_PUBLIC_KEY=
NEXT_PUBLIC_REPO_URL=
